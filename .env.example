# Set these in Vercel > Project > Settings > Environment Variables. Never commit real values.
SITE_URL=https://glashausresort.com

# Stripe (Dashboard > Developers > API keys). Start with test keys (sk_test_...), switch to live after a test booking.
STRIPE_SECRET_KEY=
# Stripe > Developers > Webhooks > add endpoint https://glashausresort.com/api/stripe-webhook
# events: checkout.session.completed, checkout.session.expired
STRIPE_WEBHOOK_SECRET=

# Supabase project (same one Legacy uses, or a new one)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Airbnb > Listing > Availability > Connect calendars > Export calendar (copy the .ics link)
AIRBNB_ICAL_URL=

# Any long random string. The Airbnb import URL becomes https://glashausresort.com/calendar.ics?key=THIS
ICAL_EXPORT_KEY=

# Optional: booking emails to Sara and the guest (resend.com, verify glashausresort.com as a sending domain)
RESEND_API_KEY=
EMAIL_FROM=Glashaus <stay@glashausresort.com>
HOST_EMAIL=glashausresort@gmail.com

# Policy pages. Also enter both URLs in Stripe > Settings > Business > Public details.
# Setting TERMS_URL makes Stripe Checkout show a required "I agree to the terms" checkbox.
TERMS_URL=https://glashausresort.com/terms
PRIVACY_URL=https://glashausresort.com/privacy

# Prices. Must match window.GLASHAUS in index.html.
RATE_WEEKNIGHT=475
RATE_WEEKEND=499
AIRBNB_FEE_MARKUP=0.20
CLEANING_FEE=0
LODGING_TAX_RATE=0.12
MIN_NIGHTS=1
